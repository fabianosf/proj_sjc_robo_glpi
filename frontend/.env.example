# URL base da API FastAPI (somente leitura).
# Deve coincidir com host/porta do run_api.bat (SGC_API_PORT).
# CORS liberado apenas para http://localhost:5173 e http://127.0.0.1:5173.
#
# Exemplos:
#   VITE_API_BASE_URL=http://127.0.0.1:8001
#   VITE_API_BASE_URL=http://127.0.0.1:8000

VITE_API_BASE_URL=http://127.0.0.1:8001
