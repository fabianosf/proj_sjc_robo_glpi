[Unit]
Description=Projeto SGC - Sistema de Gestão de Chamados
After=network.target

[Service]
Type=simple
User=sdesk
WorkingDirectory=/home/sdesk/PROJ_SGC
Environment="PATH=/home/sdesk/PROJ_SGC/venv/bin"
Environment="SGC_AGENDADOR_AUTO=1"
Environment="HOST=0.0.0.0"
Environment="PORT=5005"
Environment="LD_LIBRARY_PATH=/home/sdesk/PROJ_SGC/drivers/oracle_linux/instantclient_21_1"
Environment="ORACLE_HOME=/home/sdesk/PROJ_SGC/drivers/oracle_linux/instantclient_21_1"
ExecStart=/home/sdesk/PROJ_SGC/venv/bin/python /home/sdesk/PROJ_SGC/main.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
